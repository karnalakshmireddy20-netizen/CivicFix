# =============================================================================
# CivicFix — Environment Variables Example
# Copy this file to .env and fill in YOUR values.
# NEVER commit .env or any file containing real credentials.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/civicfix?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long random string (32+ characters) in production
JWT_SECRET=replace-with-a-strong-random-secret-key-minimum-32-chars
JWT_EXPIRATION=86400000

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Server Port (optional) ───────────────────────────────────────────────────
PORT=8080

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Set this in frontend/.env (not this file)
VITE_API_URL=http://localhost:8080
