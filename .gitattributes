# Normalize line endings to LF on commit (cross-platform consistency)
* text=auto eol=lf

# Java / config files
*.java    text eol=lf
*.xml     text eol=lf
*.properties text eol=lf
*.sql     text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# Web
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.svg     text eol=lf

# Binary — do not touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.jar     binary
